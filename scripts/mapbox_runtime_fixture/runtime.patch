+ const rings=[...(snap.structures||[]).map(roof=>roof.outline),...(snap.manualPlanes||[]).map(roof=>roof.points)]
+  .filter(ring=>Array.isArray(ring)&&ring.length>=3)
+  .map(ring=>ring.map(point=>[Number(point.lat??point[0]),Number(point.lng??point[1])]));
+ const points=rings.flat();
+ if(!points.length||points.some(p=>p.some(v=>!Number.isFinite(v))))return null;
+ const lat=points[0][0],lon=points[0][1],cos=Math.cos(lat*Math.PI/180);
+ const projected=rings.map(r=>r.map(([y,x])=>[(x-lon)*cos,lat-y]));
+ const xs=projected.flat().map(p=>p[0]),ys=projected.flat().map(p=>p[1]);
+ const left=Math.min(...xs),top=Math.min(...ys),w=Math.max(...xs)-left,h=Math.max(...ys)-top;
+ if(!(w>0&&h>0))return null;
+ const canvas=document.createElement('canvas');canvas.width=1400;canvas.height=760;
+ const ctx=canvas.getContext('2d'),scale=Math.min(1160/w,570/h);
+ ctx.fillStyle='#fff';ctx.fillRect(0,0,1400,760);
+ ctx.fillStyle='#122a40';ctx.font='bold 38px Arial';ctx.fillText('Saved roof outline',54,58);
+ ctx.fillStyle='#41576b';ctx.font='26px Arial';ctx.fillText('Plan view · Imagery omitted',54,718);
+ projected.forEach(ring=>{
+  ctx.beginPath();ring.forEach(([x,y],i)=>ctx[i?'lineTo':'moveTo'](700+(x-left-w/2)*scale,386+(y-top-h/2)*scale));
+  ctx.closePath();ctx.fillStyle='#dceef1';ctx.fill();ctx.strokeStyle='#186675';ctx.lineWidth=7;ctx.lineJoin='round';ctx.stroke();
+ });
+ const image=new Image();image.alt='Saved roof outline on a plain background';image.src=canvas.toDataURL('image/png');
+ Object.assign(image.style,{display:'block',width:'100%',height:'100%',objectFit:'contain'});
+ return image;
+}
